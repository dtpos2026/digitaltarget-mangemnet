rules_version = '2';

// Digital Target Portal — Firestore Security Rules
//
// Data layout:
//   roles/{uid}                           login account → role, workspaceUid, permissions[], teamId, disabled
//   users/{ws}/meta/settings              company settings (logo, footer…)
//   users/{ws}/{collection}/{id}          business data (clients, leads, invoices…)
//   users/{ws}/waAccounts|waConversations|waOutbox   WhatsApp (written by whatsapp-service)
//   waSessions/**                         WhatsApp session keys — service only, never clients
//
// The block between GENERATED:BEGIN and GENERATED:END is produced from
// src/lib/permission-presets.json by `npm run rules:generate`. Do not edit it by hand.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity ----------
    function signedIn() { return request.auth != null; }
    function rolePath(uid) { return /databases/$(database)/documents/roles/$(uid); }
    function me() { return get(rolePath(request.auth.uid)).data; }
    function active() {
      return signedIn() && exists(rolePath(request.auth.uid)) && me().get('disabled', false) != true;
    }
    function isSuper(r) { return r.role in superRoles(); }
    function permsOf(r) {
      return isSuper(r) ? allPermissions() : r.get('permissions', presets().get(r.role, []));
    }
    function canAny(ps) { return active() && permsOf(me()).hasAny(ps); }
    function member(ws) { return active() && me().workspaceUid == ws; }
    function myTeamId() { return me().get('teamId', ''); }
    function canPortal() { return canAny(['myportal.view']) && myTeamId() != ''; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // GENERATED:BEGIN
    function superRoles() { return ["super_admin", "admin"]; }
    function allPermissions() { return ["dashboard.view", "leads.view", "leads.create", "leads.edit", "leads.delete", "leads.assign", "leads.own", "leads.take", "products.view", "products.manage", "whatsapp.view", "whatsapp.reply", "whatsapp.manage", "campaigns.manage", "clients.view", "clients.manage", "projects.view", "projects.manage", "assignments.manage", "schedule.view", "schedule.manage", "schedule.own", "queries.manage", "myportal.view", "invoices.view", "invoices.manage", "finance.view", "finance.manage", "reports.view", "performance.view", "team.view", "team.manage", "users.manage", "settings.manage", "audit.view", "data.manage", "history.manage"]; }
    function presets() { return {
      "manager": ["dashboard.view", "leads.view", "leads.create", "leads.edit", "leads.delete", "leads.assign", "whatsapp.view", "whatsapp.reply", "whatsapp.manage", "clients.view", "clients.manage", "projects.view", "projects.manage", "assignments.manage", "schedule.view", "schedule.manage", "queries.manage", "myportal.view", "invoices.view", "invoices.manage", "finance.view", "finance.manage", "reports.view", "team.view", "team.manage", "settings.manage", "data.manage", "performance.view", "campaigns.manage", "leads.take", "products.view", "products.manage"],
      "lead_manager": ["leads.view", "leads.create", "leads.edit", "leads.delete", "leads.assign", "whatsapp.view", "whatsapp.reply", "schedule.view", "schedule.manage", "queries.manage", "performance.view", "campaigns.manage", "leads.take", "products.view"],
      "sales_support": ["leads.view", "leads.create", "leads.edit", "whatsapp.view", "whatsapp.reply", "clients.view", "schedule.view", "schedule.manage", "products.view"],
      "accountant": ["dashboard.view", "invoices.view", "invoices.manage", "finance.view", "finance.manage", "reports.view"],
      "social_media_manager": ["leads.view", "whatsapp.view", "whatsapp.reply", "clients.view", "projects.view", "schedule.view", "myportal.view", "products.view"],
      "graphic_designer": ["myportal.view"],
      "video_editor": ["myportal.view"],
      "assistant": ["leads.view", "leads.create", "leads.edit", "schedule.view", "schedule.manage", "products.view"],
      "team_member": ["myportal.view"],
      "custom": [],
      "sales_assistant": ["leads.own", "leads.take", "products.view", "schedule.own"]
    }; }
    function readPerms(col) { return {
      "clients": ["clients.view", "leads.view", "invoices.view", "finance.view", "projects.view", "schedule.view"],
      "projects": ["projects.view", "invoices.view", "finance.view", "schedule.view", "clients.view"],
      "invoices": ["invoices.view", "finance.view"],
      "accounting": ["finance.view", "reports.view"],
      "khata": ["finance.view"],
      "wallets": ["finance.view", "invoices.manage", "team.manage"],
      "walletTransfers": ["finance.view"],
      "budgets": ["finance.view"],
      "team": ["team.view", "finance.view", "assignments.manage", "schedule.view", "users.manage", "leads.assign", "whatsapp.reply"],
      "teamLogs": ["team.view"],
      "payouts": ["team.view", "finance.view"],
      "schedule": ["schedule.view", "dashboard.view"],
      "leads": ["leads.view"],
      "leadPhoneIndex": ["leads.own", "leads.view", "whatsapp.view"],
      "assignments": ["assignments.manage", "team.view"],
      "queries": ["queries.manage"],
      "waStats": ["performance.view", "whatsapp.view"],
      "targets": ["dashboard.view", "finance.view", "reports.view"],
      "monthlyArchives": ["history.manage"],
      "waCampaigns": ["campaigns.manage"],
      "waDailyCounts": ["campaigns.manage"],
      "optOuts": ["campaigns.manage", "leads.view", "whatsapp.view"],
      "salesState": ["leads.view", "leads.own"],
      "products": ["products.view", "products.manage", "settings.manage"],
      "quotations": ["leads.view"],
      "salesTargets": ["leads.view", "team.view"],
      "serviceCosts": ["finance.view", "invoices.view", "invoices.manage", "settings.manage"]
    }.get(col, []); }
    function writePerms(col) { return {
      "clients": ["clients.manage", "leads.edit"],
      "projects": ["projects.manage", "invoices.manage"],
      "invoices": ["invoices.manage"],
      "accounting": ["finance.manage", "invoices.manage", "team.manage"],
      "khata": ["finance.manage"],
      "wallets": ["finance.manage", "invoices.manage", "team.manage"],
      "walletTransfers": ["finance.manage"],
      "budgets": ["finance.manage"],
      "team": ["team.manage"],
      "teamLogs": ["team.manage"],
      "payouts": ["team.manage"],
      "schedule": ["schedule.manage"],
      "assignments": ["assignments.manage", "team.manage"],
      "queries": ["queries.manage"],
      "leadPhoneIndex": ["leads.create", "leads.edit", "leads.own"],
      "targets": ["finance.manage"],
      "monthlyArchives": ["history.manage"],
      "waCampaigns": ["campaigns.manage"],
      "waDailyCounts": ["campaigns.manage"],
      "optOuts": ["campaigns.manage", "leads.edit", "whatsapp.reply"],
      "salesState": ["leads.create", "leads.own"],
      "products": ["products.manage", "settings.manage"],
      "quotations": ["leads.edit"],
      "salesTargets": ["team.manage", "settings.manage", "leads.assign"],
      "serviceCosts": ["settings.manage"]
    }.get(col, []); }
    // GENERATED:END

    // ---------- login accounts ----------
    // Users can read their own role doc. Admins (users.manage) create/update
    // accounts in their own workspace, never their own doc, never grant more
    // than they hold, and only super roles can touch super-role accounts.
    function validRoleWrite(uid) {
      let d = request.resource.data;
      return d.uid == uid
        && d.workspaceUid == me().workspaceUid
        && d.role is string
        && (!(d.role in superRoles()) || isSuper(me()))
        && permsOf(d).toSet().difference(permsOf(me()).toSet()).size() == 0;
    }

    match /roles/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        (canAny(['users.manage']) && resource.data.workspaceUid == me().workspaceUid)
      );
      allow create: if canAny(['users.manage']) && uid != request.auth.uid && validRoleWrite(uid);
      allow update: if canAny(['users.manage']) && uid != request.auth.uid
        && resource.data.workspaceUid == me().workspaceUid
        && (!isSuper(resource.data) || isSuper(me()))
        && validRoleWrite(uid);
      // An administrator may link their OWN account to a team record (My Portal);
      // nothing else on their own role can change, and other roles cannot do this.
      allow update: if request.auth.uid == uid && isSuper(resource.data)
        && resource.data.workspaceUid == me().workspaceUid
        && changed().hasOnly(['teamId', 'updatedAt', 'updatedBy']);
      // Accounts are disabled (disabled: true), never deleted, so history stays intact.
      allow delete: if false;
    }

    // ---------- workspace ----------
    match /users/{ws}/meta/{docId} {
      allow read: if member(ws);
      allow write: if member(ws) && canAny(['settings.manage']);
    }

    // Generic business collections; access comes from the generated maps.
    // Collections missing from the maps are denied here (default deny).
    // p = permsOf(me()), team = myTeamId(): worked out once by the caller.
    function ownRead(col, id, p, team) {
      return team != '' && (
        // My Portal (production team): own assignments, queries, logs, payouts, schedule
        (p.hasAny(['myportal.view']) && (
          (col in ['assignments', 'queries', 'teamLogs', 'payouts'] && resource.data.memberId == team) ||
          (col == 'schedule' && resource.data.assignedTo == team))) ||
        // Sales assistant: own schedule, own quotations, own targets
        (p.hasAny(['schedule.own']) && col == 'schedule' && resource.data.assignedTo == team) ||
        (p.hasAny(['leads.own']) && col in ['quotations', 'salesTargets'] && resource.data.teamId == team) ||
        // both: only their own team record
        (p.hasAny(['myportal.view', 'leads.own', 'schedule.own']) && col == 'team' && id == team)
      );
    }

    // History protection (monthly closing): records stamped with
    // `archivedMonth` belong to a closed month. Only the administrator
    // (history.manage) may change or delete them, and clients / archive
    // snapshots are never deleted from the normal portal.
    function isHistorian() { return canAny(['history.manage']); }
    function archived() { return resource.data.get('archivedMonth', '') != ''; }
    function deleteProtected(col) { return col in ['clients', 'monthlyArchives']; }

    match /users/{ws}/{col}/{id} {
      allow read: if member(ws) && (canAny(readPerms(col)) || ownRead(col, id, permsOf(me()), myTeamId()));
      allow create: if member(ws) && canAny(writePerms(col));
      allow update: if member(ws) && canAny(writePerms(col)) && (!archived() || isHistorian());
      // The administrator may delete protected / archived records, but only in
      // business collections (writePerms): never the audit log, chats, outbox…
      allow delete: if member(ws) && writePerms(col).size() > 0 && (
        isHistorian() ||
        (canAny(writePerms(col)) && !deleteProtected(col) && !archived())
      );
    }

    // Leads: separate create / edit / assign / delete permissions.
    // Sales assistants (leads.own) see only their own leads and the open pool
    // (unassigned); they can TAKE a pool lead, work on their own leads, and —
    // because their WhatsApp may be the one that captures the message — add
    // new conversation data to any lead without seeing it.
    // Read: only documents whose assignedTo is mine or '' (legacy leads without
    // the field are not part of the pool). Queries must filter on assignedTo.
    function salesRead(p, team) {
      return p.hasAny(['leads.own']) && team != ''
        && (resource.data.assignedTo == team || resource.data.assignedTo == '');
    }
    // Permissions are worked out once (permsOf) and passed in.
    function leadUpdate(p, team) {
      let owner = resource.data.get('assignedTo', '');
      let nextOwner = request.resource.data.get('assignedTo', '');
      let sa = p.hasAny(['leads.own']) && team != '';
      return p.hasAny(['leads.edit'])
        // assign / reassign (status only to Assigned / New)
        || (p.hasAny(['leads.assign'])
            && changed().hasOnly(['assignedTo', 'assignedToName', 'assignedAt', 'assignedBy', 'takenBy', 'takenByName', 'takenAt', 'status', 'history', 'updatedAt', 'updatedBy'])
            && (!('status' in changed()) || request.resource.data.status in ['Assigned', 'New']))
        // own lead: work on it, or hand it back to the pool
        || (sa && owner == team && (nextOwner == team || nextOwner == ''))
        // TAKE LEAD from the pool (first one wins: the second sees an owner and is refused)
        || (sa && p.hasAny(['leads.take']) && owner == '' && nextOwner == team && request.resource.data.get('takenBy', '') == team)
        // captured WhatsApp messages / analysis on any lead (write-only)
        || (sa && changed().hasOnly(['chat', 'lastMessageAt', 'lastMessageText', 'lastInboundAt', 'unreadCount',
              'history', 'ai', 'interest', 'leadType', 'adInfo', 'waJid', 'phoneE164', 'waLabels', 'vip', 'priority', 'business', 'updatedAt']));
    }
    match /users/{ws}/leads/{id} {
      allow read: if member(ws) && salesRead(permsOf(me()), myTeamId());
      allow create: if member(ws) && (canAny(['leads.create']) || (canAny(['leads.own']) && myTeamId() != ''));
      allow update: if member(ws) && leadUpdate(permsOf(me()), myTeamId());
      allow delete: if member(ws) && canAny(['leads.delete']);
    }

    // Sales assistants (schedule.own): their own schedule items only — always assigned to themselves.
    function ownSchedule(p, team) { return p.hasAny(['schedule.own']) && team != ''; }
    match /users/{ws}/schedule/{id} {
      allow create: if member(ws) && ownSchedule(permsOf(me()), myTeamId())
        && request.resource.data.assignedTo == myTeamId();
      allow update: if member(ws) && ownSchedule(permsOf(me()), myTeamId())
        && resource.data.assignedTo == myTeamId() && request.resource.data.assignedTo == myTeamId() && !archived();
      allow delete: if member(ws) && ownSchedule(permsOf(me()), myTeamId())
        && resource.data.assignedTo == myTeamId() && !archived();
    }

    // Quotation / sales cards: an assistant creates and updates only their own (teamId).
    function ownSales(p, team) { return p.hasAny(['leads.own']) && team != ''; }
    match /users/{ws}/quotations/{id} {
      allow create: if member(ws) && ownSales(permsOf(me()), myTeamId())
        && request.resource.data.teamId == myTeamId();
      allow update: if member(ws) && ownSales(permsOf(me()), myTeamId())
        && resource.data.teamId == myTeamId() && request.resource.data.teamId == myTeamId();
    }

    // Own sales profile on the team record (shown on quotation cards) — never pay / rate fields.
    match /users/{ws}/team/{id} {
      allow update: if member(ws) && ownSales(permsOf(me()), myTeamId()) && id == myTeamId()
        && changed().hasOnly(['phone', 'whatsapp', 'email', 'designation', 'photo', 'updatedAt']);
    }

    // My Portal: team members update status / chat on their own assignments…
    match /users/{ws}/assignments/{id} {
      allow update: if member(ws) && canPortal()
        && resource.data.memberId == myTeamId()
        && changed().hasOnly(['status', 'messages']);
    }

    // …and raise / reply to their own queries.
    match /users/{ws}/queries/{id} {
      allow create: if member(ws) && canPortal()
        && request.resource.data.memberId == myTeamId()
        && request.resource.data.status == 'Open';
      allow update: if member(ws) && canPortal()
        && resource.data.memberId == myTeamId()
        && changed().hasOnly(['messages']);
    }

    // ---------- WhatsApp ----------
    // Status, QR and session fields are written only by whatsapp-service (Admin SDK).
    match /users/{ws}/waAccounts/{id} {
      allow read: if member(ws) && canAny(['whatsapp.view']);
      allow create: if member(ws) && canAny(['whatsapp.manage'])
        && request.resource.data.status == 'disconnected';
      allow update: if member(ws) && canAny(['whatsapp.manage'])
        && changed().hasOnly(['command', 'settings', 'label', 'expectedPhone']);
    }

    match /users/{ws}/waConversations/{id} {
      allow read: if member(ws) && canAny(['whatsapp.view']);
      allow update: if member(ws) && canAny(['whatsapp.reply'])
        && changed().hasOnly(['assignedTo', 'assignedToName', 'tags', 'notes', 'followUpDate',
                              'unreadCount', 'leadId', 'archived', 'pinned', 'updatedAt', 'updatedBy']);

      match /messages/{messageId} {
        allow read: if member(ws) && canAny(['whatsapp.view']);
      }
    }

    // Replies are queued here; the service validates the conversation and sends.
    match /users/{ws}/waOutbox/{id} {
      allow read: if member(ws) && canAny(['whatsapp.view']);
      allow create: if member(ws) && canAny(['whatsapp.reply'])
        && request.resource.data.keys().hasOnly(['id', 'accountId', 'conversationId', 'text', 'status',
                                                 'createdBy', 'createdByEmail', 'createdAt', 'media'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'queued'
        && request.resource.data.conversationId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4096
        && (request.resource.data.text.size() > 0 || validOutboxMedia(ws))
        && (!('media' in request.resource.data) || validOutboxMedia(ws));
    }
    // Attachments must be files this workspace uploaded to its own outbox folder.
    function validOutboxMedia(ws) {
      let m = request.resource.data.media;
      return m is map && m.keys().hasOnly(['path', 'mimetype', 'fileName', 'size'])
        && m.path is string && m.path.matches('workspaces/' + ws + '/whatsapp-outbox/[^/]+/[^/]+');
    }

    // ---------- notifications (one doc per recipient) ----------
    match /users/{ws}/notifications/{id} {
      allow read, delete: if member(ws) && resource.data.userUid == request.auth.uid;
      allow update: if member(ws) && resource.data.userUid == request.auth.uid
        && changed().hasOnly(['read', 'readAt']);
      allow create: if member(ws) && request.resource.data.createdBy == request.auth.uid;
    }

    // ---------- audit log ----------
    // Entries are append-only (never edited). Only the administrator
    // (history.manage) may delete old ones, to keep storage small.
    match /users/{ws}/auditLogs/{id} {
      allow read: if member(ws) && canAny(['audit.view']);
      allow create: if member(ws) && request.resource.data.actorUid == request.auth.uid;
      allow delete: if member(ws) && isHistorian();
    }

    // ---------- public invoice verification (QR on invoices) ----------
    // Anyone holding the random 32-hex token may read that one summary (no
    // listing). Only invoice managers of the owning workspace can write it.
    match /invoiceVerify/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if canAny(['invoices.manage'])
        && request.resource.data.workspaceUid == me().workspaceUid
        && request.resource.data.token == token;
      allow update: if canAny(['invoices.manage'])
        && resource.data.workspaceUid == me().workspaceUid
        && request.resource.data.workspaceUid == me().workspaceUid
        && request.resource.data.token == token;
      allow delete: if false;
    }

    // waSessions/** and anything not matched above: no client access.
  }
}
