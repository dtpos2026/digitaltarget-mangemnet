{
  "manifest_version": 3,
  "name": "Digital Target WhatsApp Connector",
  "short_name": "DT WhatsApp",
  "version": "1.4.0",
  "description": "Opens WhatsApp Web inside the Digital Target portal and captures chats into leads. No server needed.",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Digital Target WhatsApp", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["declarativeNetRequest", "storage", "scripting"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://digital-target007.web.app/*",
    "https://digital-target007.firebaseapp.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "declarative_net_request": {
    "rule_resources": [{ "id": "embed", "enabled": true, "path": "rules.json" }]
  },
  "content_scripts": [
    {
      "matches": [
        "https://digital-target007.web.app/*",
        "https://digital-target007.firebaseapp.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["wa-frame-guard.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["vendor/wppconnect-wa.js", "wa-agent.js"],
      "run_at": "document_end",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["wa-relay.js"],
      "css": ["wa-panel.css"],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
