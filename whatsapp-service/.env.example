# ---- Required ----
# 32-byte key that encrypts the WhatsApp session in Firestore. Generate with:
#   npm run gen-key
# Keep it secret and stable: changing it forces a new QR scan.
WA_SESSION_KEY=

# Firebase Admin credentials. On Cloud Run / GCE the attached service account
# is used automatically; locally point this at a service-account JSON file
# (Firebase Console → Project settings → Service accounts → Generate key).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GOOGLE_CLOUD_PROJECT=digital-target007

# Bucket for images / documents / voice notes (leave empty to skip media download)
FIREBASE_STORAGE_BUCKET=digital-target007.firebasestorage.app

# ---- Optional ----
# Only serve one workspace (the admin's uid). Empty = every workspace.
WORKSPACE_UID=
PORT=8080
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=warn
# Time zone for the lead "date" field
TZ_LEADS=Asia/Karachi
# Max media size to download (MB)
MEDIA_MAX_MB=16
# Minimum gap between messages sent from the portal (ms) — keeps sending human-paced
SEND_INTERVAL_MS=1500
# Local testing only: store the session unencrypted when WA_SESSION_KEY is empty
ALLOW_PLAINTEXT_SESSION=false
